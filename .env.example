# NodeGet 主题构建期环境变量示例
# 复制为 .env.local 后修改即可（.env.local 不会进入 Git 仓库 / 编译产物）

# 方式 A：完整 JSON 字符串，写入 dist/config.json
# NODEGET_CONFIG={"user_preferences":{"site_name":"My Status","site_logo":"/favicon.svg","footer":"Powered by NodeGet"},"site_tokens":[{"name":"master-1","backend_url":"wss://your-backend.example.com","token":"YOUR_TOKEN"}]}

# 方式 B：分字段（与方式 A 二选一）
# SITE_NAME=My Status
# SITE_LOGO=/favicon.svg
# SITE_FOOTER=Powered by NodeGet
# SITE_1=name="master-1", backend_url="wss://your-backend.example.com", token="YOUR_TOKEN"
# SITE_2=name="master-2", backend_url="wss://another.example.com", token="ANOTHER_TOKEN"
